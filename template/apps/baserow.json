{
	"categories": [
		"Other",
		"Tools"
	],
	"description": "Baserow is a free and open-source no-code database and spreadsheet-hybrid tool, an open-source alternative to Airtable. This template uses the all-in-one image, which bundles its own PostgreSQL and Redis in a single container for simple deployments.",
	"env": [
		{
			"description": "e.g. http://192.168.1.50 or https://baserow.example.com",
			"label": "BASEROW_PUBLIC_URL",
			"name": "BASEROW_PUBLIC_URL"
		}
	],
	"image_arm64": "baserow/baserow:latest",
	"image_amd64": "baserow/baserow:latest",
	"logo": "https://raw.githubusercontent.com/pi-hosted/pi-hosted/master/images/baserow.png",
	"name": "baserow",
	"officialDoc": "https://baserow.io/docs/installation/install-with-docker",
	"platform": "linux",
	"ports": [
		"7388:80/tcp"
	],
	"restart_policy": "unless-stopped",
	"title": "Baserow",
	"type": 1,
	"volumes": [
		{
			"bind": "/portainer/Files/AppData/Config/Baserow",
			"container": "/baserow/data"
		}
	],
	"webpage": "https://baserow.io/"
}
