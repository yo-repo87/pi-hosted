{
	"categories": [
		"Video",
		"Music",
		"Photos"
	],
	"description": "Jellyfin with Emby-style extras: copy settings when creating a user, easy PIN sign-in on your network, scheduled backups, automatic merging of duplicate movies, a bulk metadata editor and TheTVDB built in. Web UI on port 8097.",
	"logo": "https://raw.githubusercontent.com/jellyfin/jellyfin-ux/master/branding/SVG/icon-transparent.svg",
	"name": "jellyfin-enhanced",
	"platform": "linux",
	"ports": [
		"8097:8096/tcp",
		"8920:8920/tcp"
	],
	"restart_policy": "unless-stopped",
	"title": "Jellyfin Enhanced",
	"type": 1,
	"volumes": [
		{
			"bind": "/portainer/Files/AppData/Config/Jellyfin-Enhanced",
			"container": "/config"
		},
		{
			"bind": "/portainer/Files/AppData/Config/Jellyfin-Enhanced/cache",
			"container": "/cache"
		},
		{
			"bind": "/portainer/TV",
			"container": "/data/tvshows"
		},
		{
			"bind": "/portainer/Movies",
			"container": "/data/movies"
		}
	],
	"webpage": "https://github.com/yo-repo87/Jellyfin_Enhanced",
	"env": [
		{
			"default": "America/New_York",
			"label": "TZ",
			"name": "TZ"
		}
	],
	"image_arm64": "ghcr.io/yo-repo87/jellyfin-enhanced:latest",
	"image_amd64": "ghcr.io/yo-repo87/jellyfin-enhanced:latest"
}
