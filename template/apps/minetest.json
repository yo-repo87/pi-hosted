{
	"categories": [
		"Other"
	],
	"description": "Server version of Luanti (formerly Minetest — renamed in October 2024 due to a trademark dispute), a free, open source alternative to minecraft.",
	"env": [
		{
			"default": "1000",
			"label": "PUID",
			"name": "PUID"
		},
		{
			"default": "1000",
			"label": "PGID",
			"name": "PGID"
		}
	],
	"image_arm64": "lscr.io/linuxserver/luanti:latest",
	"image_amd64": "lscr.io/linuxserver/luanti:latest",
	"logo": "https://raw.githubusercontent.com/yo-repo87/pi-hosted/master/images/luanti-icon.png",
	"name": "luanti",
	"officialDoc": "https://docs.linuxserver.io/images/docker-luanti",
	"platform": "linux",
	"ports": [
		"30000:30000/udp"
	],
	"restart_policy": "unless-stopped",
	"title": "Luanti (formerly Minetest)",
	"type": 1,
	"volumes": [
		{
			"container": "/config/.minetest"
		}
	],
	"webpage": "https://www.luanti.org/"
}
