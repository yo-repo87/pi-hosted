{
	"categories": [
		"Other",
		"Tools"
	],
	"description": "Radicale is a free and open-source CalDAV and CardDAV server for calendars and contacts, simple to set up and lightweight enough to run on a Raspberry Pi.",
	"image_arm64": "tomsquest/docker-radicale:latest",
	"image_amd64": "tomsquest/docker-radicale:latest",
	"logo": "https://raw.githubusercontent.com/pi-hosted/pi-hosted/master/images/radicale.png",
	"name": "radicale",
	"officialDoc": "https://github.com/tomsquest/docker-radicale#quick-start",
	"platform": "linux",
	"ports": [
		"5232:5232/tcp"
	],
	"restart_policy": "unless-stopped",
	"title": "Radicale",
	"type": 1,
	"volumes": [
		{
			"bind": "/portainer/Files/AppData/Config/Radicale/config",
			"container": "/config"
		},
		{
			"bind": "/portainer/Files/AppData/Config/Radicale/data",
			"container": "/data"
		}
	],
	"webpage": "https://radicale.org/"
}
