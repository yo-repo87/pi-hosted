{
	"categories": [
		"Video",
		"Tools"
	],
	"description": "Tdarr is automated media transcoding and health-checking — build library-wide transcode workflows (e.g. re-encode to H.265, strip unwanted audio tracks) that run across your Sonarr/Radarr/Jellyfin/Plex media library. This template runs the combined server + internal node; add the separate tdarr_node image on other machines to distribute transcode workload.",
	"env": [
		{
			"default": "1000",
			"label": "PUID",
			"name": "PUID"
		},
		{
			"default": "1000",
			"label": "PGID",
			"name": "PGID"
		},
		{
			"default": "America/New_York",
			"label": "TZ",
			"name": "TZ"
		},
		{
			"default": "0.0.0.0",
			"label": "serverIP",
			"name": "serverIP"
		},
		{
			"default": "8266",
			"label": "serverPort",
			"name": "serverPort"
		},
		{
			"default": "8265",
			"label": "webUIPort",
			"name": "webUIPort"
		},
		{
			"default": "true",
			"label": "internalNode",
			"name": "internalNode"
		}
	],
	"image_arm64": "haveagitgat/tdarr:latest",
	"image_amd64": "haveagitgat/tdarr:latest",
	"logo": "https://raw.githubusercontent.com/yo-repo87/pi-hosted/master/images/tdarr.png",
	"name": "tdarr",
	"officialDoc": "https://docs.tdarr.io/docs/installation/docker/run-compose/",
	"platform": "linux",
	"ports": [
		"8265:8265/tcp",
		"8266:8266/tcp",
		"8267:8267/tcp"
	],
	"restart_policy": "unless-stopped",
	"title": "Tdarr",
	"type": 1,
	"volumes": [
		{
			"bind": "/portainer/Files/AppData/Config/Tdarr/server",
			"container": "/app/server"
		},
		{
			"bind": "/portainer/Files/AppData/Config/Tdarr/configs",
			"container": "/app/configs"
		},
		{
			"bind": "/portainer/Files/AppData/Config/Tdarr/logs",
			"container": "/app/logs"
		},
		{
			"bind": "/portainer/Media",
			"container": "/media"
		},
		{
			"bind": "/portainer/Files/AppData/Config/Tdarr/transcode_cache",
			"container": "/temp"
		}
	],
	"webpage": "https://tdarr.io/"
}
